# Copy to .env (setup.sh does this for you). Plain KEY=VALUE lines, no spaces around '='.
# .env is git-ignored - never commit real values.

# Optional but recommended. Free key: https://nvd.nist.gov/developers/request-an-api-key
# Without it NVD lookups still work but are limited to 5 requests / 30 s (with a key: 50).
NVD_API_KEY=

# Ollama model used for AI reports. setup.sh picks one that fits your RAM/GPU and
# writes it here; change it any time, e.g. qwen2.5:3b-instruct on a low-RAM machine.
SUDARSHAN_MODEL=

# --- optional settings (uncomment to use) ---------------------------------
# Extra targets allowed besides private ranges (comma-separated IPs / CIDRs / domains).
# Only list systems you are authorized to test.
# SUDARSHAN_ALLOWED_TARGETS=203.0.113.0/24,lab.example.com
# Ranges that must never be scanned, even if otherwise allowed.
# SUDARSHAN_DENIED_TARGETS=192.168.1.0/24
# Where scan results go (default: ./sudarshan-results next to the code).
# SUDARSHAN_RESULTS_DIR=
# Where the scan audit log goes (default: ~/sudarshan-audit.log).
# SUDARSHAN_AUDIT_LOG_FILE=
# Web UI port (default 8000; run.sh picks the next free port if busy).
# SUDARSHAN_PORT=8000
# Ollama server URL (default http://localhost:11434).
# OLLAMA_URL=
